# Server Port
PORT=3000

# Square Configuration (Optional - can also be configured via Admin Dashboard)
# Choose environment: "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox

# Sandbox Credentials (from developer.squareup.com)
SQUARE_SANDBOX_APP_ID=sandbox-sq0idb-xxxxxxxx
SQUARE_SANDBOX_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxxxxxx
SQUARE_SANDBOX_LOCATION_ID=Lxxxxxxxxxxxx

# Production Credentials
SQUARE_PROD_APP_ID=sq0idp-xxxxxxxx
SQUARE_PROD_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxxxxxx
SQUARE_PROD_LOCATION_ID=Lxxxxxxxxxxxx

# Admin Dashboard Password (default: Admin2026@Square)
ADMIN_PASSWORD=Admin2026@Square
